<view class="page">
  <view class="page-header">
    <view class="page-icon">
      <image class="ic" src="/images/icons/upload.png" />
    </view>
    <text class="page-title">新增食谱</text>
  </view>

  <view class="hint hint-lines">
    <text>食谱文本需包含：</text>
    <text>· 菜名</text>
    <text>· 食材：名称 + 分量</text>
    <text>· 做法：每行一步</text>
  </view>

  <textarea
    class="textarea import-input"
    value="{{importText}}"
    bindinput="onInput"
    placeholder="把你喜欢的食谱复制过来吧～"
    maxlength="-1"
  />

  <button class="btn btn-primary btn-block" bindtap="parse" disabled="{{!importText}}">解析</button>

  <view class="status-note" wx:if="{{importStatus}}">{{importStatus}}</view>

  <view class="empty" wx:if="{{drafts.length == 0}}">
    <text class="empty-title">等待解析</text>
    <text class="empty-text">粘贴文本后先「解析」，再编辑预览保存。</text>
  </view>

  <view class="draft-list">
    <view class="draft-card" wx:for="{{drafts}}" wx:key="id" wx:for-item="draft" wx:for-index="idx">
      <view class="draft-head" wx:if="{{draft.parseFailed}}">
        <text class="warning">需补全</text>
      </view>

      <view class="field">
        <text class="field-label">标题</text>
        <input class="input" value="{{draft.title}}" data-id="{{draft.id}}" data-field="title" bindinput="updateDraft" placeholder="菜名" />
      </view>

      <view class="field">
        <view class="field-head">
          <text class="field-label">食材</text>
          <button class="btn btn-ghost btn-sm" bindtap="addIngredient" data-draft-id="{{draft.id}}" data-category="食材">
            <image class="ic ic-14" src="/images/icons/plus.png" />添加
          </button>
        </view>
        <view
          class="ingredient-row"
          wx:for="{{draft.ingredients}}"
          wx:key="id"
          wx:for-item="item"
          wx:if="{{item.category == '食材'}}"
        >
          <input class="input ing-name" value="{{item.name}}" data-draft-id="{{draft.id}}" data-item-id="{{item.id}}" data-field="name" bindinput="updateIngredient" placeholder="名称" />
          <input class="input ing-amount" value="{{item.amount}}" data-draft-id="{{draft.id}}" data-item-id="{{item.id}}" data-field="amount" bindinput="updateIngredient" placeholder="分量" />
          <view class="icon-btn danger" data-draft-id="{{draft.id}}" data-item-id="{{item.id}}" bindtap="removeIngredient">
            <image class="ic ic-15" src="/images/icons/trash.png" />
          </view>
        </view>
      </view>

      <view class="field">
        <view class="field-head">
          <text class="field-label">调味料</text>
          <button class="btn btn-ghost btn-sm" bindtap="addIngredient" data-draft-id="{{draft.id}}" data-category="调味料">
            <image class="ic ic-14" src="/images/icons/plus.png" />添加
          </button>
        </view>
        <view
          class="ingredient-row"
          wx:for="{{draft.ingredients}}"
          wx:key="id"
          wx:for-item="item"
          wx:if="{{item.category == '调味料'}}"
        >
          <input class="input ing-name" value="{{item.name}}" data-draft-id="{{draft.id}}" data-item-id="{{item.id}}" data-field="name" bindinput="updateIngredient" placeholder="名称" />
          <input class="input ing-amount" value="{{item.amount}}" data-draft-id="{{draft.id}}" data-item-id="{{item.id}}" data-field="amount" bindinput="updateIngredient" placeholder="分量" />
          <view class="icon-btn danger" data-draft-id="{{draft.id}}" data-item-id="{{item.id}}" bindtap="removeIngredient">
            <image class="ic ic-15" src="/images/icons/trash.png" />
          </view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">做法</text>
        <textarea class="textarea" value="{{draft.method}}" data-id="{{draft.id}}" data-field="method" bindinput="updateDraft" maxlength="-1" />
      </view>

      <view class="field" wx:if="{{draft.rawText}}">
        <text class="field-label">原始文本</text>
        <textarea class="textarea" value="{{draft.rawText}}" data-id="{{draft.id}}" data-field="rawText" bindinput="updateDraft" maxlength="-1" />
      </view>
    </view>
  </view>

  <button class="btn btn-primary btn-block save-btn" wx:if="{{drafts.length > 0}}" bindtap="save">保存全部食谱</button>
</view>
