.page {
  padding: 24rpx;
  padding-bottom: 80rpx;
}

.hint {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.import-input {
  min-height: 280rpx;
  margin-bottom: 20rpx;
}

.draft-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.draft-card {
  padding: 28rpx;
  border: 1px solid var(--border);
  border-radius: 16rpx;
  background: var(--card);
}

.draft-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.draft-title {
  font-size: 30rpx;
  font-weight: 700;
}

.warning {
  font-size: 22rpx;
  color: #8a4d16;
  background: #fbe8c9;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 700;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-label {
  font-size: 26rpx;
  color: var(--label);
  font-weight: 600;
}

.ingredient-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ingredient-row .input {
  flex: 1;
}

.save-btn {
  margin-top: 32rpx;
}
