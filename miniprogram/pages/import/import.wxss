.page {
  padding: 24rpx;
  padding-bottom: 80rpx;
}

.hint {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
  margin-bottom: 16rpx;
}

/* 关键字段提示：一行一条 */
.hint-lines {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.import-input {
  min-height: 280rpx;
  margin-bottom: 20rpx;
}

/* 「解析」按钮与下方「等待解析」方框留出呼吸空间 */
.page .empty {
  margin-top: 32rpx;
}

.draft-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.draft-card {
  padding: 28rpx;
  border: 1px solid var(--border);
  border-radius: 16rpx;
  background: var(--card);
  box-shadow: var(--shadow-sm);
}

/* 仅剩「需补全」徽标时靠右上 */
.draft-head {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}

.warning {
  font-size: 22rpx;
  color: #8a4d16;
  background: #fbe8c9;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 700;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-head .btn {
  margin: 0;
  width: auto;
  min-width: 0;
}

.field-label {
  font-size: 26rpx;
  color: var(--label);
  font-weight: 600;
}

.ingredient-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ingredient-row .ing-name {
  flex: 1;
  min-width: 180rpx;
}

.ingredient-row .ing-amount {
  width: 300rpx;
  flex: none;
}

.save-btn {
  margin-top: 32rpx;
}

.import-actions {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.import-actions .btn-primary {
  flex: 1;
}

.import-actions .btn-ghost {
  white-space: nowrap;
}
