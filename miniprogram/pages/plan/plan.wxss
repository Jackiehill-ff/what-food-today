.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.day-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.day-controls .day-header {
  flex: 1;
  text-align: center;
}

.today-btn {
  margin-top: 16rpx;
}

.plan-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.plan-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
  padding: 28rpx;
  border: 1px solid var(--border);
  border-radius: 16rpx;
  background: var(--card);
}

.plan-thumb {
  width: 112rpx;
  height: 112rpx;
}

.plan-main {
  flex: 1;
  min-width: 0;
}

.plan-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.plan-count {
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.plan-menu {
  width: 100%;
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1px dashed #e1e7df;
}

.method-block {
  margin-bottom: 16rpx;
}

.method-title {
  font-size: 24rpx;
  color: var(--day-ink);
  margin-bottom: 6rpx;
}

.method-block text {
  font-size: 26rpx;
  color: #33453c;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.menu-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.menu-small {
  flex: 1;
}

.menu-small.danger {
  color: var(--danger);
  border-color: #e6d4cf;
}

.menu-date {
  flex: 1;
}

.picker-panel {
  margin-top: 32rpx;
}

.picker-results {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.picker-item {
  width: 100%;
  min-height: 64rpx;
  padding: 0 24rpx;
  text-align: left;
  background: var(--card);
  border-radius: 16rpx;
  font-size: 28rpx;
  border: 1px solid var(--border);
  color: var(--ghost-ink);
  overflow-wrap: anywhere;
}
