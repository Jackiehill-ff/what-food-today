.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.top-actions {
  display: flex;
  gap: 10rpx;
}

.top-actions .small {
  min-height: 56rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

.shop-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.shop-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--card);
  border-radius: 14rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(29, 37, 33, 0.04);
}

.shop-item.checked {
  opacity: 0.6;
}

.shop-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.shop-name {
  font-size: 28rpx;
}

.shop-name.done {
  text-decoration: line-through;
}

.shop-amount {
  font-size: 24rpx;
  color: var(--muted);
}

.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--muted);
}

.field-row {
  display: flex;
  gap: 16rpx;
}

.field-row .field {
  flex: 1;
  min-width: 0;
}

.picker-value {
  padding: 18rpx 20rpx;
  border: 1px solid var(--border);
  border-radius: 12rpx;
  background: #fff;
  font-size: 28rpx;
}
