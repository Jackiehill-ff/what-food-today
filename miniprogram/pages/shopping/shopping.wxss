.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.top-actions {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.top-actions .btn {
  flex: 1;
  white-space: nowrap;
}

.shop-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}

.shop-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border: 1px solid #e1e7df;
  border-radius: 16rpx;
  background: var(--card);
  box-shadow: var(--shadow-sm);
}

.shop-item.checked {
  color: #738077;
  background: #eef3ee;
}

.shop-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.shop-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

/* 名称深绿粗体 + 数量灰色同行，来源说明灰色第二行（对齐参考图排版） */
.shop-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ghost-ink);
  overflow-wrap: anywhere;
}

.shop-name.done {
  text-decoration: line-through;
  color: #738077;
  font-weight: 600;
}

.shop-amount {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--muted);
  white-space: nowrap;
}

.shop-source {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted-3);
  overflow-wrap: anywhere;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--label);
  font-weight: 600;
}

.field-row {
  display: flex;
  gap: 16rpx;
}

.field-row .field {
  flex: 1;
  min-width: 0;
}

.picker-value {
  padding: 16rpx 20rpx;
  border: 1px solid var(--input-border);
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 28rpx;
  min-height: 76rpx;
  display: flex;
  align-items: center;
}

.shop-edit {
  flex-shrink: 0;
}

.edit-footer {
  display: flex;
  gap: 16rpx;
}

.edit-delete {
  color: var(--danger);
  border-color: #e6d4cf;
  white-space: nowrap;
}

.edit-save {
  flex: 1;
}

/* 长按拖动排序（与菜单计划页一致） */
.shop-item.dragging {
  position: relative;
  z-index: 10;
  box-shadow: 0 12rpx 32rpx rgba(20, 32, 27, 0.22);
  opacity: 0.96;
}

/* tabBar 图标字形占画布比例小于「我的」页图标，放大到 52rpx 保持视觉一致 */
.page-icon .ic {
  width: 52rpx;
  height: 52rpx;
}
