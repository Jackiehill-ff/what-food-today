.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.top-actions {
  display: flex;
  gap: 10rpx;
}

.top-actions .btn {
  white-space: nowrap;
}

.shop-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}

.shop-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border: 1px solid #e1e7df;
  border-radius: 16rpx;
  background: var(--card);
}

.shop-item.checked {
  color: #738077;
  background: #eef3ee;
}

.shop-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 10rpx;
}

.shop-name {
  font-size: 28rpx;
  overflow-wrap: anywhere;
}

.shop-name.done {
  text-decoration: line-through;
}

.shop-amount {
  font-size: 24rpx;
  color: var(--muted);
  white-space: nowrap;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--label);
  font-weight: 600;
}

.field-row {
  display: flex;
  gap: 16rpx;
}

.field-row .field {
  flex: 1;
  min-width: 0;
}

.picker-value {
  padding: 16rpx 20rpx;
  border: 1px solid var(--input-border);
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 28rpx;
  min-height: 76rpx;
  display: flex;
  align-items: center;
}
