<view class="page" wx:if="{{draft}}">
  <!-- 成品图 -->
  <view class="image-editor">
    <view class="thumb edit-thumb {{draft.image ? '' : 'thumb-placeholder'}}">
      <image wx:if="{{draft.image}}" class="thumb-img" src="{{draft.image}}" mode="aspectFill" />
      <image wx:else class="thumb-icon" src="/images/icons/soup-placeholder.png" />
    </view>
    <view class="image-actions">
      <button wx:if="{{!draft.image}}" class="btn btn-ghost btn-sm" bindtap="chooseImage">上传成品图</button>
      <button wx:else class="btn btn-ghost btn-sm danger" bindtap="removeImage">移除图片</button>
    </view>
  </view>

  <!-- 名称 / 分类 -->
  <view class="field-row">
    <view class="field">
      <text class="field-label">食谱名称</text>
      <input class="input" value="{{draft.title}}" data-field="title" bindinput="onFieldInput" placeholder="番茄炒蛋" />
    </view>
    <view class="field">
      <text class="field-label">分类</text>
      <input class="input" value="{{draft.category}}" data-field="category" bindinput="onFieldInput" placeholder="家常菜" />
    </view>
  </view>

  <!-- 食材：列表呈现，点某一项弹出编辑框 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">食材</text>
      <button class="btn btn-ghost btn-sm" bindtap="addItem" data-category="食材">
        <image class="ic ic-14" src="/images/icons/plus.png" />添加
      </button>
    </view>
    <view class="ing-empty" wx:if="{{food.length == 0}}">
      <text>还没有食材，点右上角「添加」</text>
    </view>
    <view
      class="ing-row food-row {{dragSection == 'food' && dragIndex == index ? 'dragging' : ''}}"
      wx:for="{{food}}"
      wx:key="id"
      wx:for-item="item"
      wx:for-index="index"
      data-section="food"
      data-id="{{item.id}}"
      data-index="{{index}}"
      bindtap="openItemEditor"
      bindlongpress="onRowLongPress"
      catchtouchmove="{{dragSection == 'food' ? 'onRowTouchMove' : ''}}"
      bindtouchend="onRowTouchEnd"
      bindtouchcancel="onRowTouchEnd"
      style="{{dragSection == 'food' ? (dragIndex == index ? 'transform: translateY(' + dragOffset + 'px);' : (dragShifts[index] ? 'transform: translateY(' + dragShifts[index] + 'px);' : '')) : ''}}"
    >
      <view class="ing-text">
        <text class="ing-name">{{item.name}}</text>
        <text class="ing-amount" wx:if="{{item.amountText}}">{{item.amountText}}</text>
      </view>
      <view class="ing-edit">
        <image class="ic ic-14" src="/images/icons/edit.png" />
        <text>编辑</text>
      </view>
    </view>
  </view>

  <!-- 调味料：同上 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">调味料</text>
      <button class="btn btn-ghost btn-sm" bindtap="addItem" data-category="调味料">
        <image class="ic ic-14" src="/images/icons/plus.png" />添加
      </button>
    </view>
    <view class="ing-empty" wx:if="{{seasoning.length == 0}}">
      <text>还没有调味料，点右上角「添加」</text>
    </view>
    <view
      class="ing-row seasoning-row {{dragSection == 'seasoning' && dragIndex == index ? 'dragging' : ''}}"
      wx:for="{{seasoning}}"
      wx:key="id"
      wx:for-item="item"
      wx:for-index="index"
      data-section="seasoning"
      data-id="{{item.id}}"
      data-index="{{index}}"
      bindtap="openItemEditor"
      bindlongpress="onRowLongPress"
      catchtouchmove="{{dragSection == 'seasoning' ? 'onRowTouchMove' : ''}}"
      bindtouchend="onRowTouchEnd"
      bindtouchcancel="onRowTouchEnd"
      style="{{dragSection == 'seasoning' ? (dragIndex == index ? 'transform: translateY(' + dragOffset + 'px);' : (dragShifts[index] ? 'transform: translateY(' + dragShifts[index] + 'px);' : '')) : ''}}"
    >
      <view class="ing-text">
        <text class="ing-name">{{item.name}}</text>
        <text class="ing-amount" wx:if="{{item.amountText}}">{{item.amountText}}</text>
      </view>
      <view class="ing-edit">
        <image class="ic ic-14" src="/images/icons/edit.png" />
        <text>编辑</text>
      </view>
    </view>
  </view>

  <!-- 做法 / 备注 -->
  <view class="field">
    <text class="field-label">做法步骤</text>
    <textarea class="textarea" value="{{draft.method}}" data-field="method" bindinput="onFieldInput" placeholder="每行写一步，实际做饭时更容易扫读。" />
  </view>
  <view class="field">
    <text class="field-label">原始文本 / 备注</text>
    <textarea class="textarea" value="{{draft.rawText}}" data-field="rawText" bindinput="onFieldInput" placeholder="无" />
  </view>

  <view class="form-actions">
    <button class="btn btn-primary btn-block" bindtap="save" disabled="{{!draft.title}}">保存食谱</button>
    <button class="btn btn-ghost btn-block" bindtap="cancel">取消</button>
  </view>
</view>

<!-- 单项编辑弹窗（无「单位」栏；删除在右上角，排序用列表长按拖动） -->
<view class="modal-mask" wx:if="{{editing}}" catchtouchmove="noop">
  <view class="modal" catchtap="noop">
    <view class="modal-header">
      <view class="modal-title">{{editing.section == 'seasoning' ? '编辑调味料' : '编辑食材'}}</view>
      <view class="icon-btn modal-delete" bindtap="deleteEditingItem">
        <image class="ic ic-16" src="/images/icons/trash.png" />
      </view>
    </view>
    <view class="modal-body">
      <view class="field">
        <text class="field-label">名称</text>
        <input class="input" value="{{editing.name}}" data-field="name" bindinput="onEditField" placeholder="名称" />
      </view>
      <view class="field">
        <text class="field-label">数量</text>
        <input class="input" value="{{editing.amount}}" data-field="amount" bindinput="onEditField" placeholder="无" />
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn btn-ghost" bindtap="cancelEditing">取消</button>
      <button class="btn btn-primary" bindtap="saveEditing">保存</button>
    </view>
  </view>
</view>
