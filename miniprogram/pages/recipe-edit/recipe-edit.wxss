.page {
  padding: 24rpx;
  padding-bottom: 80rpx;
}

.image-editor {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.edit-thumb {
  width: 200rpx;
  height: 200rpx;
}

.image-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.field-row {
  display: flex;
  gap: 16rpx;
}

.field-row .field {
  flex: 1;
  min-width: 0;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--label);
  font-weight: 600;
}

.section {
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

/* 原生 button 自带 margin:auto 与固定宽度（184px），显式清零并收缩为紧凑尺寸，保证靠右与「分类」列对齐 */
.section-head .btn,
.image-actions .btn {
  margin: 0;
  width: auto;
  min-width: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

/* 食材/调味料列表行：名称 + 数量（有才显示），右侧「编辑」入口；长按拖动排序 */
.ing-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  /* 兄弟项让位时平滑滑动 */
  transition: transform 120ms ease-out;
}

.ing-row.dragging {
  position: relative;
  z-index: 10;
  box-shadow: 0 12rpx 32rpx rgba(20, 32, 27, 0.22);
  opacity: 0.96;
  /* 拖动项 1:1 跟手，不让过渡产生弹跳 */
  transition: none;
}

.ing-text {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.ing-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  word-break: break-word;
  overflow-wrap: anywhere;
}

.ing-amount {
  font-size: 26rpx;
  color: var(--muted);
}

.ing-edit {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 18rpx;
  border: 1px solid #d6ddd4;
  border-radius: 12rpx;
  background: #ffffff;
  color: var(--ghost-ink);
  font-size: 24rpx;
  flex-shrink: 0;
}

.ing-empty {
  padding: 24rpx;
  border: 1px dashed var(--input-border);
  border-radius: 16rpx;
  background: var(--card);
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
  margin-bottom: 12rpx;
}

/* 弹窗右上角删除按钮 */
.modal-delete {
  flex-shrink: 0;
}

.form-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}
