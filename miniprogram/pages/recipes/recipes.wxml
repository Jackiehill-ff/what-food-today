<view class="page">
  <view class="section-header">
    <text class="section-title">食谱库</text>
    <button class="btn btn-primary add-btn" bindtap="startNew">＋ 新增食谱</button>
  </view>

  <view class="status-note" wx:if="{{statusMessage}}">{{statusMessage}}</view>

  <view class="search-box">
    <input
      class="input"
      value="{{recipeSearch}}"
      bindinput="onSearchInput"
      placeholder="搜索标题、分类、食材"
      confirm-type="search"
    />
  </view>

  <scroll-view class="category-scroll" scroll-x wx:if="{{categories.length > 0}}">
    <view class="category-filters">
      <view class="chip {{recipeCategory === '' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="">全部</view>
      <view
        class="chip {{recipeCategory === category ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        wx:for-item="category"
        bindtap="onCategoryTap"
        data-category="{{category}}"
      >
        {{category}}
      </view>
    </view>
  </scroll-view>

  <view class="feed">
    <view class="empty" wx:if="{{filtered.length === 0}}">
      <text class="empty-title">还没有食谱</text>
      <text class="empty-text">点右上角「新增食谱」创建一道常做菜，或到导入中心导入。</text>
    </view>

    <view class="feed-card" wx:for="{{filtered}}" wx:key="id" wx:for-item="recipe">
      <view class="feed-main" bindtap="toggleExpand" data-id="{{recipe.id}}">
        <view class="thumb feed-thumb {{recipe.image ? '' : 'thumb-placeholder'}}">
          <image wx:if="{{recipe.image}}" class="thumb-img" src="{{recipe.image}}" mode="aspectFill" />
          <text wx:else class="thumb-emoji">🥣</text>
        </view>
        <view class="feed-text">
          <view class="feed-title">{{recipe.title}}</view>
          <view class="feed-summary">{{recipe.summary || '暂无食材'}}</view>
        </view>
        <view class="chevron">{{expandedId === recipe.id ? '▲' : '▼'}}</view>
      </view>

      <view class="feed-detail" wx:if="{{expandedId === recipe.id}}">
        <view class="method-block">
          <view class="method-title">做法</view>
          <text class="{{recipe.method ? '' : 'muted'}}">{{recipe.method || '暂无做法'}}</text>
        </view>
        <view class="feed-actions">
          <view class="menu-add">
            <view class="icon-btn" bindtap="toggleMenuPicker" data-id="{{recipe.id}}">＋</view>
            <view class="menu-add-options" wx:if="{{menuPickerId === recipe.id}}">
              <button bindtap="addToDate" data-id="{{recipe.id}}" data-date="{{todayKey}}">今天</button>
              <button bindtap="addToDate" data-id="{{recipe.id}}" data-date="{{tomorrowKey}}">明天</button>
            </view>
          </view>
          <view class="icon-btn" bindtap="editRecipe" data-id="{{recipe.id}}">✎</view>
          <view class="icon-btn danger" bindtap="deleteRecipe" data-id="{{recipe.id}}">🗑</view>
        </view>
      </view>
    </view>
  </view>

  <ingredient-popup visible="{{popupVisible}}" recipe="{{popupRecipe}}" bind:close="onPopupClose" bind:add="onPopupAdd" />
</view>
