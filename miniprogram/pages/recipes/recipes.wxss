.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.search-box {
  margin-bottom: 20rpx;
}

.category-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.category-filters {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  min-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  background: #ffffff;
  border: 1px solid #d6ddd4;
  color: #53665d;
}

.chip.active {
  border-color: var(--accent);
  color: #244c3e;
  background: var(--accent-bg);
}

.feed {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feed-card {
  padding: 28rpx;
  border: 1px solid var(--border);
  border-radius: 16rpx;
  background: var(--card);
}

.feed-card.expanded {
  border-color: var(--accent);
}

.feed-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
}

.feed-thumb {
  width: 168rpx;
  height: 168rpx;
}

.feed-text {
  flex: 1;
  min-width: 0;
}

.feed-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.feed-summary {
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 6rpx;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.chevron {
  color: #819087;
}

.feed-detail {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1px solid #e7ece4;
}

.method-block {
  margin-bottom: 16rpx;
}

.method-title {
  font-size: 24rpx;
  color: var(--day-ink);
  margin-bottom: 6rpx;
}

.method-block text {
  font-size: 26rpx;
  color: #33453c;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.feed-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.menu-add {
  position: relative;
}

.menu-add-options {
  position: absolute;
  top: calc(100% + 10rpx);
  right: 0;
  z-index: 20;
  display: flex;
  gap: 10rpx;
  padding: 10rpx;
  border: 1px solid #d6ddd4;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(20, 32, 27, 0.18);
}

.menu-add-options button {
  min-height: 60rpx;
  padding: 0 24rpx;
  border: 1px solid var(--border);
  border-radius: 16rpx;
  color: #244c3e;
  font-weight: 600;
  background: var(--card);
  white-space: nowrap;
  font-size: 26rpx;
}
