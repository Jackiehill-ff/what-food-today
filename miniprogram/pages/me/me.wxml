<view class="page">
  <view class="page-header">
    <view class="page-icon">
      <image class="ic" src="/images/icons/user.png" />
    </view>
    <text class="page-title">我的</text>
  </view>

  <!-- 账号 -->
  <view class="card panel">
    <view class="panel-head">
      <text class="panel-title">账号</text>
      <view class="head-right">
        <text class="openid-inline" wx:if="{{openidMasked}}">{{openidMasked}}</text>
        <text class="sync-tag">{{syncTagText}}</text>
      </view>
    </view>

    <block wx:if="{{!isCloudEnabled}}">
      <view class="muted">未开通云开发，当前继续使用本地数据。</view>
    </block>

    <block wx:elif="{{user}}">
      <view class="profile-row">
        <button
          class="avatar-btn"
          style="width:96rpx;height:96rpx;margin:0;padding:0;"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
        >
          <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
          <view wx:else class="avatar avatar-empty">
            <image class="avatar-icon" src="/images/icons/soup-brand.png" />
          </view>
        </button>
        <input
          class="input nickname-input"
          type="nickname"
          value="{{nickname}}"
          bindinput="onNicknameInput"
          bindblur="onNicknameBlur"
          placeholder="设置昵称"
        />
        <button class="btn btn-ghost btn-sm logout-btn" bindtap="logout">退出登录</button>
      </view>
    </block>

    <block wx:else>
      <view class="muted">登录后可将账号与数据关联（当前数据仍保存在本机）。</view>
      <button class="btn btn-primary btn-block login-btn" bindtap="loginTap" disabled="{{busy}}">
        {{busy ? '登录中…' : '微信一键登录'}}
      </button>
    </block>

    <view class="panel-msg" wx:if="{{accountMessage}}">{{accountMessage}}</view>
  </view>

  <!-- 数据 -->
  <view class="card panel">
    <view class="panel-head">
      <text class="panel-title">数据</text>
    </view>
    <view class="muted">导出备份，或从聊天文件（如 recipes.json）导入恢复。</view>
    <view class="row-actions">
      <button class="btn btn-ghost" bindtap="exportData">导出</button>
      <button class="btn btn-ghost" bindtap="importData">导入</button>
    </view>
    <view class="panel-msg" wx:if="{{dataStatus}}">{{dataStatus}}</view>
  </view>

  <!-- 统计 -->
  <view class="card panel">
    <view class="panel-head">
      <text class="panel-title">统计</text>
    </view>
    <view class="stats">
      <view class="stat">
        <text class="stat-num">{{stats.recipes}}</text>
        <text class="stat-label">食谱</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{stats.planned}}</text>
        <text class="stat-label">已安排</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{stats.shopping}}</text>
        <text class="stat-label">采购项</text>
      </view>
    </view>
  </view>
</view>
