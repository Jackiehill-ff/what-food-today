.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ghost-ink);
}

.sync-tag {
  font-size: 22rpx;
  color: #203d33;
  background: var(--accent-warm);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

/* 面板头右侧：状态标签 + 用户编码同行 */
.head-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.openid-inline {
  font-size: 22rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 原生 button 的 UA 固定宽度会盖过 class 样式，尺寸同时写进 WXML 内联样式兜底（正圆） */
.avatar-btn {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  line-height: 1;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: block;
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-warm);
}

.avatar-empty .avatar-icon {
  width: 56rpx;
  height: 56rpx;
}

/* 昵称输入框占满头像与退出按钮之间的剩余空间 */
.nickname-input {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
}

/* 退出登录：紧凑小按钮贴右，不再占整行（两级类名压过原生 button 的 UA 固定宽度 184px） */
.profile-row .logout-btn {
  flex-shrink: 0;
  margin: 0;
  width: auto;
  min-width: 0;
}

.row-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.row-actions .btn {
  flex: 1;
  min-width: 180rpx;
}

.login-btn {
  margin-top: 8rpx;
}

.panel-msg {
  font-size: 24rpx;
  color: var(--primary-dark);
}

.stats {
  display: flex;
  gap: 16rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  background: #f7f4ee;
  border-radius: 16rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand);
}

.stat-label {
  font-size: 24rpx;
  color: var(--muted);
}
