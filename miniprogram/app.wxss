/* 全局样式与设计变量（对齐原 APP styles.css 的配色与组件规格） */
page {
  --bg: #f6f2ec;
  --text: #1d2521;
  --muted: #66776d;
  --label: #42534b;
  --brand: #254139;
  --primary: #2f6f57;
  --primary-dark: #275c49;
  --ghost-ink: #2d4d42;
  --danger: #a43e35;
  --yellow: #f8d46b;
  --panel: #ffffff;
  --card: #fbfcfa;
  --border: #dfe5dc;
  --input-border: #cfd8ce;
  --accent: #88a394;
  --accent-bg: #eaf2eb;
  --accent-bg-2: #eef5ef;
  --day-bg: #eef5ef;
  --day-ink: #315849;
  --status-bg: #e4eee5;
  --placeholder-icon: #a9b8ae;
  --placeholder-bg: #f3f7f2;

  background: var(--bg);
  color: var(--text);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
    "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view,
text,
button,
input,
textarea,
image {
  box-sizing: border-box;
}

button {
  font: inherit;
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  border-radius: 0;
  line-height: inherit;
  color: inherit;
}

button::after {
  border: none;
}

/* 通用按钮（对齐 .primary-button / .ghost-button） */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  border: 1px solid transparent;
}

.btn-primary {
  background: var(--primary);
  color: #ffffff;
}

.btn-primary:disabled {
  opacity: 0.45;
}

.btn-ghost {
  color: var(--ghost-ink);
  background: #ffffff;
  border-color: #d6ddd4;
}

.btn-danger {
  color: var(--danger);
}

.btn-block {
  width: 100%;
}

.btn-sm {
  min-height: 68rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
}

/* 图标按钮（对齐 .icon-button） */
.icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  border: 1px solid #d6ddd4;
  color: var(--ghost-ink);
  background: #ffffff;
}

.icon-btn.danger {
  color: var(--danger);
}

.icon-btn.sm {
  width: 68rpx;
  height: 68rpx;
}

.icon-btn.plain {
  border-color: transparent;
  background: transparent;
}

/* 线条图标（PNG，由 lucide 同源路径生成） */
.ic {
  display: block;
  flex-shrink: 0;
}

.ic-14 {
  width: 28rpx;
  height: 28rpx;
}

.ic-15 {
  width: 30rpx;
  height: 30rpx;
}

.ic-16 {
  width: 32rpx;
  height: 32rpx;
}

.ic-17 {
  width: 34rpx;
  height: 34rpx;
}

.ic-18 {
  width: 36rpx;
  height: 36rpx;
}

.ic-22 {
  width: 44rpx;
  height: 44rpx;
}

.ic-24 {
  width: 48rpx;
  height: 48rpx;
}

/* 面板卡片 */
.card {
  background: #ffffff;
  border: 1px solid var(--border);
  border-radius: 16rpx;
  padding: 28rpx;
}

/* 标题 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 0;
}

/* 弱化文字 */
.muted {
  color: var(--muted);
}

/* 状态提示 */
.status-note {
  display: inline-block;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  color: var(--primary-dark);
  background: var(--status-bg);
  font-size: 24rpx;
}

/* 表单 */
.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--label);
  font-weight: 600;
}

.input,
.textarea {
  width: 100%;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  border: 1px solid var(--input-border);
  color: var(--text);
  background: #ffffff;
  font-size: 28rpx;
}

.input {
  min-height: 76rpx;
}

.textarea {
  min-height: 160rpx;
}

/* 空状态（对齐 .empty-state：虚线边框卡片） */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-height: 280rpx;
  padding: 36rpx;
  text-align: center;
  border: 1px dashed var(--input-border);
  border-radius: 16rpx;
  background: var(--card);
}

.empty-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.empty-text {
  font-size: 24rpx;
  color: var(--muted);
}

/* 日期头（对齐 .day-header） */
.day-header {
  padding: 20rpx 28rpx;
  border: 1px solid var(--border);
  border-radius: 16rpx;
  color: var(--day-ink);
  background: var(--day-bg);
  font-size: 32rpx;
  font-weight: 700;
}

/* 成品图缩略图（对齐 .recipe-thumb） */
.thumb {
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--placeholder-bg);
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed var(--input-border);
  background: var(--placeholder-bg);
}

.thumb-icon {
  width: 48rpx;
  height: 48rpx;
}

.thumb-icon.sm {
  width: 36rpx;
  height: 36rpx;
}

/* 分类圆点（对齐 .category-dot） */
.dot {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  color: var(--day-ink);
  background: var(--status-bg);
  font-size: 22rpx;
  white-space: nowrap;
  flex-shrink: 0;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 弹窗（对齐 .modal-overlay/.modal） */
.modal-mask {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  background: rgba(20, 32, 27, 0.45);
}

.modal {
  width: 100%;
  max-width: 640rpx;
  max-height: 86vh;
  overflow-y: auto;
  padding: 28rpx;
  border: 1px solid var(--border);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(20, 32, 27, 0.28);
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
}

.modal-subtitle {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
}

.modal-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1px solid #e7ece4;
}

/* 复选框（自绘，对齐原生 checkbox 16px 圆角） */
.checkbox {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  border: 2rpx solid var(--input-border);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.checkbox.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.checkbox .ic {
  width: 26rpx;
  height: 26rpx;
}

.divider {
  height: 1rpx;
  background: var(--border);
  margin: 16rpx 0;
}

/* 搜索框（对齐 .search-box：图标 + 输入，白色底、圆角、细边框） */
.search-box {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 76rpx;
  padding: 0 22rpx;
  border: 1px solid var(--input-border);
  border-radius: 16rpx;
  background: #ffffff;
}

.search-box .search-input {
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}
