/* 全局样式与设计变量 */
page {
  --bg: #f6f2ec;
  --text: #1d2521;
  --muted: #8a928b;
  --green: #254139;
  --green-dark: #1c4c41;
  --green-light: #345b37;
  --yellow: #f8d46b;
  --danger: #b3412f;
  --card: #ffffff;
  --border: #e7e2d9;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  font: inherit;
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  border-radius: 0;
  line-height: inherit;
  color: inherit;
}

button::after {
  border: none;
}

/* 通用按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.btn-primary {
  background: var(--green);
  color: #f8fbf8;
}

.btn-primary:disabled {
  opacity: 0.45;
}

.btn-ghost {
  border: 1px solid var(--border);
  color: var(--text);
  background: #fff;
}

.btn-danger {
  color: var(--danger);
}

.btn-block {
  width: 100%;
}

/* 标题 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--green);
}

/* 卡片 */
.card {
  background: var(--card);
  border-radius: 18rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(29, 37, 33, 0.04);
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 80rpx 40rpx;
  color: var(--muted);
  text-align: center;
}

.empty .empty-title {
  font-size: 30rpx;
  color: var(--text);
}

.empty .empty-text {
  font-size: 26rpx;
}

/* 弱化文字 */
.muted {
  color: var(--muted);
}

/* 状态提示 */
.status-note {
  margin: 12rpx 0;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: #eef3ee;
  color: var(--green);
  font-size: 26rpx;
}

/* 表单 */
.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--muted);
}

.input,
.textarea {
  width: 100%;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  border: 1px solid var(--border);
  background: #fff;
  font-size: 28rpx;
}

.textarea {
  min-height: 160rpx;
}

/* 成品图缩略图 */
.thumb {
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f0ece3;
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--green);
  background: linear-gradient(135deg, #f8d46b, #f3c85a);
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(29, 37, 33, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal {
  width: 100%;
  max-height: 86vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
}

.modal-subtitle {
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
}

.modal-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 20rpx;
}

/* 图标按钮 */
.icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  color: var(--green);
}

.icon-btn.danger {
  color: var(--danger);
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 16rpx 0;
}
