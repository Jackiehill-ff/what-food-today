/* 自包含样式（组件默认样式隔离，不依赖页面 wxss） */
.modal-mask {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  background: rgba(20, 32, 27, 0.45);
}

.modal {
  width: 100%;
  max-width: 640rpx;
  max-height: 86vh;
  overflow-y: auto;
  padding: 28rpx;
  border: 1px solid #dfe5dc;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(20, 32, 27, 0.28);
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
}

.modal-subtitle {
  font-size: 24rpx;
  color: #66776d;
  margin-top: 4rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
}

.modal-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1px solid #e7ece4;
}

.icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  border: 1px solid #d6ddd4;
  color: #2d4d42;
  background: #ffffff;
}

.ic {
  display: block;
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  border: 1px solid transparent;
}

.btn-primary {
  background: #2f6f57;
  color: #ffffff;
}

.btn-primary:disabled {
  opacity: 0.45;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-height: 200rpx;
  padding: 28rpx;
  text-align: center;
  border: 1px dashed #cfd8ce;
  border-radius: 16rpx;
  background: #fbfcfa;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1d2521;
}

.empty-text {
  font-size: 24rpx;
  color: #66776d;
}

.popup-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 12rpx;
  border-bottom: 1px solid #e7ece4;
}

.popup-item.checked {
  color: #2d4d42;
  background: #eaf2eb;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  border: 2rpx solid #cfd8ce;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.checkbox.checked {
  background: #2f6f57;
  border-color: #2f6f57;
}

.checkbox .ic {
  width: 26rpx;
  height: 26rpx;
}

.dot {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  color: #315849;
  background: #e4eee5;
  font-size: 22rpx;
  white-space: nowrap;
  flex-shrink: 0;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.popup-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.popup-item-name {
  font-size: 28rpx;
  overflow-wrap: anywhere;
}

.popup-item-amount {
  font-size: 24rpx;
  color: #66776d;
}

.select-all {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}
